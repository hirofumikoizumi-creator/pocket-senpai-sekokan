{
  "expo": {
    "name": "ポケット先輩（施工管理）",
    "slug": "pocket-senpai-sekokan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pocket-senpai",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gsw.pocketsenpai.sekoukanri",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2FBFA"
      },
      "package": "com.pocketsenpai.sekokan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F2FBFA"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf290c01-7ed1-42e5-95f9-9c2b7f887201"
      }
    },
    "owner": "hirofumikoizumi"
  }
}
